# 服务器端口
PORT=3001

# 数据库连接字符串
# 格式: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/recruitment_system"

# JWT 秘钥（生产环境请使用强密钥）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 密码加盐次数
SALT_ROUNDS=10

# CORS 允许的源（多个用逗号分隔）
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# 飞书配置
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your-app-secret

# LLM 简历解析配置（表 ai_provider_config 为空时的运行时兜底；界面保存后优先生效）
LLM_PROVIDER=minimax
MINIMAX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI 设置页密钥加密主密钥（32 字节，建议 base64 存放）。
# 未配置时由 JWT_SECRET 经 SHA-256 派生；更换此值后已落库密文将无法解密。
# AI_CONFIG_ENC_KEY=

# OpenTelemetry（留空则禁用）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SAMPLING_RATIO=1.0

# Sentry（留空则禁用）
# SENTRY_DSN=https://xxx@sentry.io/123
# SENTRY_TRACES_SAMPLE_RATE=0.1
