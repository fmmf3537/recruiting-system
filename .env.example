# ============================================
# 招聘管理系统 (ATS) - 环境变量配置示例
# ============================================
# 复制此文件为 .env 并根据实际情况修改配置
# cp .env.example .env
# ============================================

# --------------------------------------------
# 数据库配置 (PostgreSQL)
# --------------------------------------------
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=recruitment_system
DB_PORT=5432

# 本地开发（直连本机 Postgres）
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/recruitment_system?schema=public

# Docker Compose 内 server 服务会自动覆盖为 @postgres:5432，一般无需改 DATABASE_URL

# --------------------------------------------
# Redis 配置
# --------------------------------------------
# 本地开发
REDIS_URL=redis://localhost:6379

# Docker Compose 内 server 会自动设为 redis://redis:6379

# --------------------------------------------
# JWT 认证配置
# --------------------------------------------
# 至少 32 字符；生产环境请使用 openssl rand -base64 48 生成
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --------------------------------------------
# CORS（前端 origin，多个用逗号分隔）
# --------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --------------------------------------------
# 飞书（移动端 SSO，可选）
# --------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --------------------------------------------
# LLM 简历解析配置（可选）
# --------------------------------------------
# 可选值：deepseek | zhipu | kimi | minimax
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=
# KIMI_API_KEY=
# MINIMAX_API_KEY=

# --------------------------------------------
# 服务器配置
# --------------------------------------------
NODE_ENV=development
PORT=3001

# --------------------------------------------
# 文件上传
# --------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# --------------------------------------------
# Nginx 配置
# --------------------------------------------
NGINX_PORT=80

# --------------------------------------------
# SMTP 邮件配置（可选）
# --------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# SMTP_FROM=招聘系统 <your-email@example.com>
# SMTP_SECURE=false
