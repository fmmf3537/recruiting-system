# ============================================
# 招聘管理系统 (ATS) - 环境变量配置示例
# ============================================
# 复制此文件为 .env 并根据实际情况修改配置
# cp .env.example .env
# ============================================

# --------------------------------------------
# 数据库配置 (PostgreSQL)
# --------------------------------------------
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=recruitment_system
DB_PORT=5432

# 本地开发（直连本机 Postgres）
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/recruitment_system?schema=public

# Docker Compose 内 server 服务会自动覆盖为 @postgres:5432，一般无需改 DATABASE_URL

# --------------------------------------------
# Redis 配置
# --------------------------------------------
# 本地开发
REDIS_URL=redis://localhost:6379

# Docker Compose 内 server 会自动设为 redis://redis:6379

# --------------------------------------------
# JWT 认证配置
# --------------------------------------------
# 至少 32 字符；生产环境请使用 openssl rand -base64 48 生成
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --------------------------------------------
# CORS（前端 origin，多个用逗号分隔）
# --------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --------------------------------------------
# 飞书（移动端 SSO，可选）
# --------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --------------------------------------------
# LLM 简历解析配置（可选）
# --------------------------------------------
# 可选值：deepseek | zhipu | kimi | minimax
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=
# KIMI_API_KEY=
# MINIMAX_API_KEY=

# --------------------------------------------
# 服务器配置
# --------------------------------------------
NODE_ENV=development
PORT=3001

# --------------------------------------------
# 文件上传
# --------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
# 文件下载是否走 Nginx X-Accel-Redirect 内部跳转（local=Express 直接 sendFile）
# 本地开发（无 Nginx）保持 false；docker-compose 已自动为 server 注入 true
X_ACCEL_REDIRECT=false

# --------------------------------------------
# Nginx 配置
# --------------------------------------------
NGINX_PORT=80

# --------------------------------------------
# SMTP 邮件配置（可选）
# --------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# SMTP_FROM=招聘系统 <your-email@example.com>
# SMTP_SECURE=false

# --------------------------------------------
# 候选人数据匿名化定时任务（个保法合规，可选）
# --------------------------------------------
# 对「淘汰超过 2 年且未入职」的候选人自动匿名化（清空姓名/手机号/邮箱、删除简历文件）
# 值为 cron 表达式，默认建议每日凌晨 3 点执行；设为 false 或留空则关闭
# ANONYMIZE_CRON=0 3 * * *
ANONYMIZE_CRON=false

# --------------------------------------------
# 面试评估催收定时任务（可选）
# --------------------------------------------
# 面试结束（scheduledAt + duration）24 小时后仍未提交评估的面试官，发送站内催收通知
# 值为 cron 表达式，建议每小时扫描一次；设为 false 或留空则关闭
# EVALUATION_REMINDER_CRON=0 * * * *
EVALUATION_REMINDER_CRON=false
